# Copy to .env.local for local development.

# Postgres connection string. On Vercel, adding Neon from the Storage tab sets this.
# Locally, run `npm run db:local` and use the value below.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres

# Used when DATABASE_URL is not set. Netlify DB sets this automatically.
# NETLIFY_DATABASE_URL=

# The single admin login for /admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# 32+ random characters used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional public URL used in sitemap.xml (falls back to Vercel/Netlify URLs).
# NEXT_PUBLIC_SITE_URL=https://shadhiyaspeaks.com
